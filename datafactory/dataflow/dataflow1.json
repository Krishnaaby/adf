{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "datasetjson",
						"type": "DatasetReference"
					},
					"name": "rating9",
					"description": "Import data from datasetjson"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "rating9",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "ratingfilter",
					"description": "filtering movies with rating 9"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 10,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> rating9",
				"rating9 filter(Rating == 9) ~> ratingfilter",
				"ratingfilter sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}