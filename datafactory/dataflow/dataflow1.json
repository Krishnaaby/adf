{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "datasetjson",
						"type": "DatasetReference"
					},
					"name": "source1",
					"description": "raw data"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "rating9",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1",
					"description": "selecting movies with 9 rating"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Rating as short,",
				"          Title as string,",
				"          YEAR as short,",
				"          genresgenregenre as string,",
				"          movies as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> source1",
				"source1 filter(Rating == 9) ~> filter1",
				"filter1 select(mapColumn(",
				"          Rating,",
				"          Title,",
				"          YEAR,",
				"          Genre = genresgenregenre,",
				"          movies",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}